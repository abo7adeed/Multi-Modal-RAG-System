# ------------------------------------------------------------
# Backend (FastAPI + RAG pipeline)
# ------------------------------------------------------------

# Active generation provider: openrouter | ollama | opencode
GENERATION_PROVIDER=openrouter

# OpenRouter (per-request billing; ":free" models are rate limited)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_TIMEOUT=120
OPENROUTER_MAX_RETRIES=2

# OpenCode Zen (OpenAI-compatible gateway; paid per request, no free
# tier limits). NOTE: its catalogue is text-only, so image context
# is dropped and answers rely on retrieved text.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gpt-5
OPENCODE_TIMEOUT=120
OPENCODE_MAX_RETRIES=2

# Ollama - local server (no auth) OR Ollama Cloud models (no local install).
#
# Local:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=qwen3-vl:4b          # vision model; run: ollama pull qwen3-vl:4b
#
# Ollama Cloud (hosted, create a key at https://ollama.com/settings/keys):
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=
#   OLLAMA_MODEL=gpt-oss:120b-cloud
# Images are base64-encoded, so cloud works without a local server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT=300

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins for CORS (frontend dev/preview servers)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# URL prefix under which retrieved images are served
API_MEDIA_URL_PREFIX=/media
# Maximum upload size in megabytes
API_MAX_UPLOAD_SIZE_MB=25
# Maximum size in megabytes of an image attached to a chat message
# (sent base64-encoded, so ~33% larger on the wire)
API_MAX_QUERY_IMAGE_SIZE_MB=5
# Number of ranked sources returned per answer. Clients may request
# fewer or more per call via the `max_sources` field (1-10).
API_MAX_SOURCES=3

# Shared secret required in the `X-API-Key` header on every /api/v1
# request. Leave EMPTY to disable authentication entirely - correct
# for local development, unsafe for anything reachable from a
# network.
API_KEY=

# Per-client-IP request limit over a sliding window. Generation is
# billable per call, so an unthrottled endpoint is a way to spend
# your provider budget by accident.
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Retrieval
# ------------------------------------------------------------
# Document images sent to the model alongside an image the user
# attached to their question
RETRIEVAL_VISUAL_TOP_K=2

# Minimum share of a query's (rarity-weighted) content terms that must
# exist in the index for a *text* question to be answered. A query
# below this is treated as off-topic and refused without calling the
# model, which keeps answers grounded and prevents drift.
#
# Higher = stricter. Measured on the sample corpus, answerable and
# off-topic queries overlap in coverage, so raising this trades
# recall for fewer false answers. See eval/BASELINE.md.
RETRIEVAL_LEXICAL_MIN_COVERAGE=0.30

# Storage
VECTOR_STORE_DIRECTORY=data/vector_store
PROCESSED_IMAGES_DIRECTORY=data/processed/images
UPLOADS_DIRECTORY=data/uploads

# ------------------------------------------------------------
# Frontend (frontend/.env - see frontend/.env.example)
# ------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
